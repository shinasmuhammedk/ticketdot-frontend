# Application environment (development, staging, production)
APP_ENV=development

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8080

# Payment gateway mode (backend PAYMENT_GATEWAY='fake' | 'razorpay')
PAYMENT_GATEWAY=razorpay
PAYMENT_WINDOW_MINUTES=12

# JWT signing secret example (min 32 characters in production)
JWT_SECRET=super-secret-key-change-this-to-a-very-long-32-chars-string
